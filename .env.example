# ==============================================================================
# KnowledgeAI Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application & Environment
APP_NAME=KnowledgeAI
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# Note: For async SQLAlchemy, use postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://knowledge_user:knowledge_pass@localhost:5432/knowledge_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=knowledge_ai

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# AI Provider Selection (openai | gemini | ollama)
# Chat and Embeddings can be independently configured!
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama (Local) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# AI Runtime Parameters
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.60

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ==============================================================================
# Email Service Configuration (mailinator | sendgrid | smtp | console)
# ==============================================================================
EMAIL_PROVIDER=mailinator

# Mailinator Configuration (Free instant public testing)
MAILINATOR_API_KEY=
MAILINATOR_DOMAIN=mailinator.com

# SendGrid Configuration (Production delivery - ready to enable anytime)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@knowledgeai.com

# SMTP Configuration (Custom SMTP server / relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@knowledgeai.local

# Frontend Application URL (Used in activation link emails)
FRONTEND_URL=http://localhost:5173
